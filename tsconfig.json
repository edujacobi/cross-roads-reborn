{
  "_version": "24.20.0",
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */

    /* Projects */
    "incremental": true,
    /* Language and Environment */
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    /* Modules */
    "module": "NodeNext",
    /* Specify what module code is generated. */
    "rootDir": ".",
    "paths": {
      "#core/*": [
        "./src/core/*"
      ],
      "#bot/*": [
        "./src/bot/*"
      ],
      "#shared/*": [
        "./src/shared/*"
      ],
      "#api/*": [
        "./src/api/*"
      ]
    },
    "resolveJsonModule": true,
    /* Emit */
    "noEmit": false,
    "outDir": "build",
    "declaration": true,
    "sourceMap": true,
    /* Interop Constraints */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    /* Type Checking */
    "strict": true,
    "useUnknownInCatchVariables": false,
    /* Completeness */
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "build",
    "web-interface"
  ]
}

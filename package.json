{
  "name": "cross-roads-reborn",
  "version": "1.0.0",
  "description": "The return of Cross Roads",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "clear-commands": "npx tsx src/bot/clear-commands.ts",
    "build": "npm run lint && rimraf build && tsc",
    "build:ci": "rimraf build && tsc",
    "start": "pm2 start build/src/index.js --name \"cr\" --max-memory-restart 450M",
    "start:tsx": "pm2 start src/index.ts --name \"cr\" --interpreter ./node_modules/.bin/tsx --max-memory-restart 450M",
    "stop": "pm2 stop cr",
    "deploy": "npx tsx src/bot/deploy-commands.ts",
    "dev": "set NODE_ENV=DEV&& npx tsx src/index.ts -w",
    "deploy:dev": "set NODE_ENV=DEV&& npx tsx src/bot/deploy-commands.ts",
    "clear-commands:dev": "set NODE_ENV=DEV&& npx tsx src/bot/clear-commands.ts",
    "lint": "npx eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "index": "npx tsx scripts/index-codebase.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc:check": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "rpg",
    "game"
  ],
  "imports": {
    "#core/*": {
      "types": "./src/core/*.ts",
      "default": "./build/src/core/*.js"
    },
    "#bot/*": {
      "types": "./src/bot/*.ts",
      "default": "./build/src/bot/*.js"
    },
    "#shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./build/src/shared/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edujacobi/cross-roads-reborn.git"
  },
  "author": "Jacobi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/edujacobi/cross-roads-reborn/issues"
  },
  "homepage": "https://github.com/edujacobi/cross-roads-reborn#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.0.3",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.74",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord-api-types": "0.38.16",
    "discord.js": "14.21.0",
    "pino": "9.0.0",
    "pino-pretty": "^13.1.1",
    "pm2": "^6.0.8",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.6"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "esbuild@0.25.12": true
  }
}

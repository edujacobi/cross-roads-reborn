{
  "name": "cross-roads-reborn",
  "version": "1.0.0",
  "description": "The return of Cross Road's Battle Roosters!",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clear": "rimraf build",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clear-commands": "tsc && node build/clear-commands.js",
    "prestart": "npm run build",
    "start": "pm2 start build/index.js --name \"cr\"",
    "stop": "pm2 stop cr",
    "predeploy": "npm run build",
    "deploy": "node build/deploy-commands.js",
    "prestart-dev": "npm run build",
    "start-dev": "set NODE_ENV=DEV&& node build/index.js",
    "predeploy-dev": "npm run build",
    "deploy-dev": "set NODE_ENV=DEV&& node build/deploy-commands.js",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edujacobi/cross-roads-reborn.git"
  },
  "author": "Jacobi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/edujacobi/cross-roads-reborn/issues"
  },
  "homepage": "https://github.com/edujacobi/cross-roads-reborn#readme",
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "ts-node": "^10.9.1"
  },
  "dependencies": {
    "canvas": "^3.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord-api-types": "0.38.12",
    "discord.js": "14.20.0",
    "dotenv": "^16.5.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.6",
    "typescript": "^5.8.3"
  }
}

{
  "name": "cross-roads-reborn",
  "version": "1.0.0",
  "description": "The return of Cross Roads",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clear": "npx rimraf build",
    "prebuild": "npm run clear && npm run lint",
    "build": "tsgo",
    "build:watch": "tsgo --watch",
    "clear-commands": "npx tsx src/bot/clear-commands.ts",
    "start": "pm2 start \"npx tsx src/index.ts\" --name \"cr\"",
    "stop": "pm2 stop cr",
    "deploy": "npx tsx src/bot/deploy-commands.ts",
    "dev": "set NODE_ENV=DEV&& npx tsx src/index.ts -w",
    "deploy-dev": "set NODE_ENV=DEV&& npx tsx src/bot/deploy-commands.ts",
    "clear-commands-dev": "set NODE_ENV=DEV&& npx tsx src/bot/clear-commands.ts",
    "lint": "npx eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "rpg",
    "game"
  ],
  "imports": {
    "#core/*": {
      "types": "./src/core/*.ts",
      "default": "./build/src/core/*.js"
    },
    "#bot/*": {
      "types": "./src/bot/*.ts",
      "default": "./build/src/bot/*.js"
    },
    "#shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./build/src/shared/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edujacobi/cross-roads-reborn.git"
  },
  "author": "Jacobi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/edujacobi/cross-roads-reborn/issues"
  },
  "homepage": "https://github.com/edujacobi/cross-roads-reborn#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.0.3",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.74",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord-api-types": "0.38.16",
    "discord.js": "14.21.0",
    "dotenv": "^17.2.0",
    "pino": "9.0.0",
    "pino-pretty": "^13.1.1",
    "pm2": "^6.0.8",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.6"
  }
}
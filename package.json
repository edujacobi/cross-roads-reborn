{
  "name": "cross-roads-reborn",
  "version": "1.0.0",
  "description": "The return of Cross Road's Battle Roosters!",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clear": "rimraf build",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clear-commands": "tsc && npx tsx clear-commands.ts",
    "start": "pm2 start index.ts --name \"cr\"",
    "stop": "pm2 stop cr",
    "deploy": "npx tsx deploy-commands.ts",
    "start-dev": "set NODE_ENV=DEV&& npx tsx index.ts -w",
    "deploy-dev": "set NODE_ENV=DEV&& npx tsx deploy-commands.ts",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edujacobi/cross-roads-reborn.git"
  },
  "author": "Jacobi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/edujacobi/cross-roads-reborn/issues"
  },
  "homepage": "https://github.com/edujacobi/cross-roads-reborn#readme",
  "devDependencies": {
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "tsx": "^4.20.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.73",
    "canvas": "^3.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord-api-types": "0.38.15",
    "discord.js": "14.21.0",
    "dotenv": "^17.0.1",
    "pm2": "^6.0.8",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.6",
    "typescript": "^5.8.3"
  }
}
